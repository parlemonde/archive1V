{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Promise", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "node16",
    "incremental": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
